[Unit]
Description=Pi Gateway earthquake poll (AFAD+Kandilli → OpenBot Jarvis)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=PI_USER
Group=PI_USER
WorkingDirectory=/home/PI_USER/pi-gateway
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
Environment=HOME=/home/PI_USER
ExecStart=/home/PI_USER/pi-gateway/scripts/pi/quake-alert.sh
# HTTP 5s×2 paralel + Jarvis notify — asılı kalırsa birikmesin ama normal akış kesilmesin
TimeoutStartSec=45
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
