[Unit]
Description=Pi Gateway boot lifecycle notify (OpenBot Jarvis)
Documentation=file:///home/PI_USER/pi-gateway/docs/OPERATIONS.md
After=network-online.target openbot.service
Wants=network-online.target openbot.service

[Service]
Type=oneshot
User=PI_USER
Group=PI_USER
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
# openbot.service: loopback automation (jarvis-send) boot'ta hazır olmalı.
ExecStart=/usr/local/lib/pi-gateway/scripts/pi/boot-notify.sh
TimeoutStartSec=120
Nice=5

[Install]
WantedBy=multi-user.target
