# =============================================================================
# Pi Gateway - Production Environment
# Copy: cp .env.example .env
# Referans: docs/ENV.md
# =============================================================================

TZ=Europe/Istanbul

# --- Pi SSH ---
PI_USER=pi
PI_HOSTNAME=pi-gateway
PI_HOST=
PI_STATIC_IP=
# Opsiyonel: SSH/deploy yonetim adresi (LAN yerine Tailscale 100.x gibi)
# PI_DEPLOY_HOST=
PI_INTERFACE=eth0
REMOTE_DIR=/home/pi/pi-gateway

# --- Network mode ---
# router-dns   : Router DHCP + DNS -> Pi (router'da bir kez DNS ayari)
# adguard-dhcp : AdGuard DHCP sunar (router DHCP kapatilir, tam otomatik DNS)
NETWORK_MODE=router-dns

LAN_DOMAIN=home
LAN_GATEWAY=
LAN_SUBNET_CIDR=
ROUTER_DNS_SECONDARY=1.1.1.1
# LAN HTTPS (varsayilan). Once: make tls-certs
# HTTP lazimsa: ENABLE_TLS=false + WEAK_TLS_OK=yes (validate/doctor fail-closed)
ENABLE_TLS=true
# WEAK_TLS_OK=yes
SD_HEALTH_AUTO_RECOVER=true
# SSD/Docker/AdGuard duserse health-check otomatik kurtarir
STACK_AUTO_RECOVER=true
# Deploy sonrasi GUI sifrelerini zorla esitlemek icin true yapin (UNIFIED_LOGIN=true iken varsayilan)
SYNC_SERVICE_PASSWORDS=true
# Tek sifre: Caddy + Dozzle/Kuma/NetAlertX = AGH_ADMIN_PASSWORD
UNIFIED_LOGIN=true
# Offsite yedek (make backup-pull) max yas (gun). 0 = kontrol kapali.
OFFSITE_BACKUP_MAX_AGE_DAYS=7
# WEAK_BACKUP_OK=yes  # Mac doctor'da eski/eksik offsite icin escape

# --- AdGuard admin (otomatik config icin) ---
AGH_ADMIN_USER=admin
# ZORUNLU: degistir. Deploy CHANGE_ME / Degistir* ile basarisiz olur.
AGH_ADMIN_PASSWORD=CHANGE_ME_adguard_password

# Caddy basic_auth (dns/n8n/logs). Bos ise AGH_ADMIN_* kullanilir.
# CADDY_AUTH_USER=
# CADDY_AUTH_PASSWORD=

# --- Tailscale (https://login.tailscale.com/admin/settings/keys) ---
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=pi-gateway
# ACL sahibi (Tailscale login e-postasi) — make tailscale-acl
TAILSCALE_ACL_OWNER=
# true = http://100.x:PORT Telegram panel (Caddy auth yok — ACL siki olmali)
TS_PANEL_DIRECT_PORTS=true

# --- Bildirimler (Telegram: @BotFather + chat id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_COOLDOWN_SEC=300
NOTIFY_REPEAT_SEC=3600
NOTIFY_SLO_REPEAT_SEC=86400
NOTIFY_DISK_REPEAT_SEC=86400
# true = Hermes sole Telegram inbox (getUpdates); panel poller removed
HERMES_TELEGRAM_GATEWAY=true
# Telegram flood: kelime kelime editMessageText + tool bubble. GLM stream ayrı (HERMES_STREAMING).
HERMES_TELEGRAM_STREAMING=false
HERMES_TELEGRAM_TOOL_PROGRESS=off
# GLM token: compact tavan (96k = bülten sığar, sohbet tavanlı) + 04:00/idle reset.
# HERMES_COMPRESS_TOKEN_CAP=96000
# HERMES_SESSION_RESET_MODE=both
# HERMES_SESSION_BG_MAX_AGE_H=2

# --- Servisler ---
ENABLE_CADDY=true
ENABLE_DOZZLE=true
# Prometheus + Grafana + node-exporter (grafana.home)
ENABLE_MONITORING=true
# Deploy: DNS once, wait, then edge + apps (canary update)
ENABLE_CANARY_COMPOSE_UPDATE=true
# CANARY_DNS_WAIT_SEC=45
ENABLE_UFW=true
# SSH ban = CrowdSec (fail2ban yok)
# full | caddy-only (admin portlari yalnizca Caddy/Tailscale)
UFW_ADMIN_EXPOSURE=caddy-only
ADGUARD_WEB_PORT=8080
ADGUARD_BLOCKED_TTL=60
ADGUARD_UPSTREAM_TIMEOUT=5
ADGUARD_BOOT_WAIT_SEC=180
ADGUARD_MIN_FILTER_RULES=100000
ADGUARD_MIN_REWRITES=8
# balanced (varsayilan, TIF Medium) | aggressive (TIF Full + Fake — daha fazla RAM)
# TIF Full: AdGuard Home >=2GB. Pi 4B + Grafana/n8n/Hermes: docker stats bak.
# Multi Ultimate (reklam listesi) degil — Pro++ kalir. Pi iptables :53 NAT yok.
ADGUARD_FILTER_PROFILE=balanced
# health-check drift gorunce otomatik configure-adguard
ADGUARD_AUTO_HEAL=true
# strict | warn | off — make diagnose-dns bypass kontrolu (audit-dns-coverage)
ADGUARD_BYPASS_CHECK=strict
# ARP'taki LAN cihazlarinin en az bu yuzdesi Pi DNS kullanmali
ADGUARD_MIN_COVERAGE_PERCENT=50
# Sabit ULA IPv6 DNS (modem RDNSS = bu adres). GUA dinamik — DNS icin kullanma.
# Ornek: fd7b:7069:6777::53
PI_IPV6_ULA=
DOZZLE_PORT=9999
DOZZLE_ADMIN_USER=admin
# ZORUNLU: bos birakma — Dozzle fail-closed
DOZZLE_ADMIN_PASSWORD=CHANGE_ME_dozzle_password

# --- Uptime Kuma ---
UPTIME_KUMA_ADMIN_USER=admin
# ZORUNLU: bos birakma — post-deploy fail-closed
UPTIME_KUMA_ADMIN_PASSWORD=CHANGE_ME_uptime_kuma_password
UPTIME_KUMA_STATUS_SLUG=pi-gateway

# --- Grafana (ENABLE_MONITORING=true) ---
GRAFANA_PORT=3030
GRAFANA_ADMIN_USER=admin
# Bos ise UNIFIED_LOGIN -> AGH_ADMIN_PASSWORD
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_ROOT_URL=https://grafana.home

# --- Faz 2: Yedek ---
ENABLE_RESTIC=true
RESTIC_REPOSITORY=/mnt/ssd/pi-gateway-data/backups/restic
RESTIC_PASSWORD=CHANGE_ME_restic_password
# Bozuk repo otomatik reinit etmez; bilincli operator kurtarmasi icin true yap.
RESTIC_ALLOW_REINIT=false
# restic backup/check timeout (saniye). JMicron I/O'da asilmayi onler.
RESTIC_TIMEOUT_SEC=7200
RESTIC_CHOWN_TIMEOUT_SEC=120
RESTIC_CHECK_SUBSET=5%
# Opsiyonel: restic snapshot host etiketi (varsayilan PI_HOSTNAME)
# RESTIC_BACKUP_HOST=pi-gateway
# Mac offsite (3-2-1): make backup-pull — SSD restic tek basina yedek DEGIL
# MAC_BACKUP_DEST varsayilan ~/Backups/pi-gateway
# Haftalik otomatik: make backup-cron (onerilir)
BACKUP_CRON_WEEKDAY=0
BACKUP_CRON_HOUR=3
# Restore drill SLA (Mac: make backup-restore-drill). 0 = health-check kapali.
BACKUP_DRILL_MAX_AGE_DAYS=30
# Cloud offsite (B2/R2 S3-compatible). Local SSD repo + Mac pull kalir.
RESTIC_OFFSITE_ENABLED=false
# RESTIC_OFFSITE_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/your-bucket/pi-gateway
# RESTIC_OFFSITE_ACCESS_KEY_ID=
# RESTIC_OFFSITE_SECRET_ACCESS_KEY=
# RESTIC_OFFSITE_COPY_TIMEOUT_SEC=3600
# SSD SMART wear warn (check-ssd-smart.sh)
# SSD_WEAR_WARN_PCT=90
# SSD_REALLOC_WARN=10

# n8n webhook path secret (URL sonuna eklenir) — ZORUNLU degistir
N8N_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
# n8n webhook (Docker agi icinden)
N8N_KUMA_WEBHOOK_URL=http://n8n:5678/webhook/uptime-kuma-alert

# --- Faz 3 ---
ENABLE_N8N=true
ENABLE_NETALERTX=true
NETALERTX_PORT=20211
# Container dosya sahibi: UID=20211 (NetAlertX), GID=host kullanici grubu (setup-netalertx yazar)
# NETALERTX_UID=20211
# NETALERTX_GID=1000
# Host network; UI sadece loopback (Caddy devices.home). LAN acmak icin 0.0.0.0 + UFW bilerek.
NETALERTX_LISTEN_ADDR=172.17.0.1
# NetAlertX UI sifresi (bos ise AGH_ADMIN_PASSWORD). Caddy basic_auth kullanilmaz (API popup dongusu).
# NETALERTX_PASSWORD=
# Bos ise LAN_SUBNET_CIDR + PI_INTERFACE ile otomatik (ornek: 192.168.1.0/24 --interface=eth0)
NETALERTX_SCAN_SUBNETS=
# Yeni cihaz: NetAlertX TELEGRAM plugin (sendMessage). Hermes getUpdates'e dokunmaz.
NETALERT_NOTIFY_VIA=telegram
# WATCHDOG_ALERT_COOLDOWN_SEC=3600
# Hermes bülten/cron timeout (saniye)
# HERMES_STALE_TIMEOUT_SEC=600
# HERMES_MAX_WEB_SEARCHES=6
# HERMES_MAX_WEB_EXTRACTS=8
# HERMES_TELEGRAM_TOOL_PROGRESS=off
# HERMES_CRON_DELIVERY_TIMEOUT_SEC=900
# HERMES_MODEL_TIMEOUT=300
# systemd: HERMES_API_CALL_STALE_TIMEOUT=300 (default 90s bülteni keser)
# patch-hermes-config-pi: cron.wrap_response=false; web.search_backend=ddgs
# WATCHDOG_NOTIFY_BOT=0  # Hermes cron watchdog aktifken 0 — cift bildirim onleme
ENABLE_CROWDSEC=true
# CrowdSec threat intel: false = online API (opt-in). Default offline.
CROWDSEC_DISABLE_ONLINE_API=true
CROWDSEC_BOUNCER_KEY=
N8N_PORT=5678
# ENABLE_TLS=true iken true olmali (render/validate uyarir)
N8N_SECURE_COOKIE=true
# ZORUNLU (n8n acikken): openssl rand -hex 24 — Pi'de bos ise post-deploy otomatik uretir
N8N_ENCRYPTION_KEY=
CLOUDFLARE_TUNNEL_TOKEN=

DISK_WARN_PCT=80
DISK_PRUNE_PCT=65

# --- Depolama ---
# hybrid    : OS SD'de, data+docker SSD (/mnt/ssd) — varsayilan, en guvenilir boot
# ssd-data  : hybrid alias
# ssd-root  : SD=bootfs only, SSD=rootfs (JMicron/EEPROM riski)
STORAGE_TYPE=hybrid
# Yalnizca hybrid/ssd-data: SSD yokken SD uzerinde core DNS
# STORAGE_FALLBACK_SD=true ayni DNS degraded yolunu acar (geriye uyum)
STORAGE_FALLBACK_SD=false
# SSD kopunca Unbound+AdGuard SD'de ayakta kalsin (varsayilan true)
DNS_DEGRADED_ON_SSD_LOSS=true
# Soft-reset / probe (JMicron)
# SSD_PROBE_TIMEOUT_SEC=3
# SSD_USB_RESET_MAX=3
# SSD_USB_RESET_WINDOW_SEC=900
# SSD_USB_HOST_PORT=0   # 0=hatirlanan+USB3; >0=once bu numara
# SSD_USB_PORT_SCAN_MAX=8
# SSD_USB_PORT_FORGET_FAILS=2
# SSD_USB_PORT_ROTATE=true
# SSD_USB_CYCLE_ON_HANG=true
# SSD_USB_STORAGE_REBIND=true
# SSD_USB_XHCI_REBIND=false
# SSD_USB_XHCI_AUTO_ON_DROPOUT=true   # bus dropout: xhci without SSD_USB_XHCI_REBIND=true
# SSD_USB_XHCI_RESET_MAX=2
# SSD_USB_XHCI_RESET_WINDOW_SEC=900
# SSD_HOTPLUG_DEBOUNCE_SEC=30
# SSD_USB_RESET_REBOOT=false
# SSD_USB_AUTHORIZED_RESET=false  # true: authorized 0→1 (JMS583 bazen kaybolur)
# SSD_USB_PORT_DISABLE_CYCLE=true   # usb2-port disable (tak-cikar yerine)
# hybrid: Docker data-root SSD'ye (JMicron USB I/O riski — varsayilan kapali)
ENABLE_DOCKER_SSD=false
DOCKER_SSD_ROOT=/mnt/ssd/docker
# Docker 29+ containerd store on USB SSD (JMicron): homepage segfault — default SD
CONTAINERD_ON_SSD=false
CONTAINERD_SSD_ROOT=/mnt/ssd/containerd
