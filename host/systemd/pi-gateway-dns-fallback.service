[Unit]
Description=Pi Gateway host DNS fallback (DoT) when AdGuard is down
After=network-online.target
Wants=network-online.target
StartLimitBurst=8
StartLimitIntervalSec=60

[Service]
Type=simple
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
ExecStart=/usr/bin/python3 /usr/local/lib/pi-gateway/scripts/lib/dns-dot-proxy.py
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
