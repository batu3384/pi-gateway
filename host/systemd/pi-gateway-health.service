[Unit]
Description=Pi Gateway DNS health check
After=network-online.target docker.service pi-gateway-boot-notify.service
OnFailure=pi-gateway-health-failure.service

[Service]
Type=oneshot
User=PI_USER
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
ExecStart=/usr/local/lib/pi-gateway/scripts/pi/health-check.sh
TimeoutStartSec=180
Nice=19
IOSchedulingClass=idle
