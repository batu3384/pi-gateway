# Pi Gateway Gatus — config-as-code durum ve SLO izleme paneli
# Render: render-config.sh — sistem alarmlari tek kanaldan (notify.sh -> OpenBot Jarvis) yonetilir (cift bildirim yok)
# UI: status.home (Caddy basic auth arkasi). Storage: ../data/gatus (sqlite)
log:
  level: warn

storage:
  type: sqlite
  path: /data/gatus.db

# SLO heartbeat'lar: push-slo-heartbeat.sh (health timer) buraya POST eder
external-endpoints:
  - name: slo-storage
    group: slo
    token: "${GATUS_PUSH_TOKEN_STORAGE}"
  - name: slo-offsite-backup
    group: slo
    token: "${GATUS_PUSH_TOKEN_OFFSITE}"
  - name: slo-restore-drill
    group: slo
    token: "${GATUS_PUSH_TOKEN_DRILL}"

endpoints:
  - name: AdGuard DNS
    group: dns
    url: http://host.docker.internal:${ADGUARD_WEB_PORT}/
    interval: 2m
    conditions:
      - "[STATUS] == 200"

  - name: Glance
    group: panels
    url: http://glance:8080/
    interval: 2m
    conditions:
      - "[STATUS] == 200"

  - name: Caddy gateway
    group: panels
    url: http://caddy:80/
    headers:
      Host: gateway.${LAN_DOMAIN}
    client:
      ignore-redirect: true
    interval: 2m
    conditions:
      - "[CONNECTED] == true"
      - "[STATUS] == any(200, 301, 308, 401)"

  - name: Dozzle
    group: panels
    url: http://dozzle:8080/
    interval: 2m
    conditions:
      - "[STATUS] == 200"

  - name: Gatus self
    group: panels
    url: http://localhost:8080/
    interval: 5m
    conditions:
      - "[STATUS] == 200"

  - name: NetAlertX
    group: panels
    url: http://host.docker.internal:${NETALERTX_PORT}/
    interval: 2m
    conditions:
      - "[STATUS] == 200"

  - name: Grafana
    group: panels
    url: http://grafana:3000/api/health
    interval: 2m
    conditions:
      - "[STATUS] == 200"

  - name: VictoriaMetrics
    group: monitoring
    url: http://victoriametrics:8428/health
    interval: 2m
    conditions:
      - "[STATUS] == 200"

  - name: node-exporter
    group: monitoring
    url: http://host.docker.internal:9100/metrics
    interval: 2m
    conditions:
      - "[STATUS] == 200"

  - name: gateway-state
    group: monitoring
    url: http://gateway-state/state.json
    interval: 2m
    conditions:
      - "[STATUS] == 200"
      - "[BODY].storage_degraded == 0"
