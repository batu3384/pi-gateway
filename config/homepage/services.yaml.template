title: Pi Gateway
description: Ev agi DNS ve homelab paneli

server:
  base: docker
  showStats: false

services:
  - AdGuard Home:
      href: ${PANEL_PROTOCOL}://dns.${LAN_DOMAIN}
      description: DNS filtreleme
      icon: adguard-home.png

  - Homepage:
      href: ${PANEL_PROTOCOL}://gateway.${LAN_DOMAIN}
      description: Kontrol paneli
      icon: homepage.png

  - Uptime Kuma:
      href: ${PANEL_PROTOCOL}://status.${LAN_DOMAIN}
      description: Servis izleme
      icon: uptime-kuma.png

  - Dozzle:
      href: ${PANEL_PROTOCOL}://logs.${LAN_DOMAIN}
      description: Container loglari
      icon: dozzle.png

  - n8n:
      href: ${PANEL_PROTOCOL}://n8n.${LAN_DOMAIN}
      description: Otomasyon
      icon: n8n.png

  - NetAlertX:
      href: ${PANEL_PROTOCOL}://devices.${LAN_DOMAIN}
      description: Ag cihaz envanteri
      icon: mdi-lan

  - Grafana:
      href: ${PANEL_PROTOCOL}://grafana.${LAN_DOMAIN}
      description: Metrik grafikleri
      icon: grafana.png

widgets:
  - resources:
      cpu: true
      memory: true
      disk: /
  - customapi:
      label: Gateway durumu
      url: http://gateway-state/state.json
      refreshInterval: 120000
      mappings:
        - field: ts
          label: Guncellendi
          format: relativeDate
        - field: storage_degraded
          label: Depolama modu
        - field: ssd_mount_healthy
          label: SSD saglik
        - field: docker_root_on_ssd
          label: Docker SSD
        - field: containerd_on_ssd
          label: containerd SSD
        - field: root_usage_pct
          label: SD doluluk
          format: percent
        - field: ssd_usage_pct
          label: SSD doluluk
          format: percent
        - field: offsite_backup_age_days
          label: Offsite yedek (gun)
        - field: dns_coverage_percent
          label: DNS kapsam (%)
        - field: dns_coverage_status
          label: DNS kapsam durumu
        - field: backup_restore_drill_age_days
          label: Restore drill (gun)
        - field: dns_latency_ms
          label: DNS gecikme (ms)
        - field: panel_latency_ms
          label: Panel gecikme (ms)
        - field: hosts_online
          label: Evde (adet)
        - field: who_home
          label: Kim evde
  - uptimekuma:
      url: ${PANEL_PROTOCOL}://status.${LAN_DOMAIN}
      slug: ${UPTIME_KUMA_STATUS_SLUG}
