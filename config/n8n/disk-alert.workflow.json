{
  "id": "f2222222-2222-4222-8222-222222222201",
  "versionId": "f2222222-2222-4222-8222-222222222202",
  "name": "Pi Gateway — Disk Uyarisi",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "id": "b1b2c3d4-2222-4000-8000-000000000001",
      "name": "Her 6 saatte",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "command": "df -P /host-ssd 2>/dev/null | tail -n +2"
      },
      "id": "b1b2c3d4-2222-4000-8000-000000000002",
      "name": "Disk durumu",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [520, 300]
    },
    {
      "parameters": {
        "jsCode": "const threshold = __DISK_WARN_PCT__;\nconst stdout = $input.first().json.stdout || '';\nconst alerts = [];\nfor (const line of stdout.trim().split('\\n').filter(Boolean)) {\n  const parts = line.trim().split(/\\s+/);\n  if (parts.length < 6) continue;\n  const pct = parseInt(parts[4].replace('%', ''), 10);\n  const mount = parts[5];\n  const size = parts[1];\n  const used = parts[2];\n  if (!Number.isNaN(pct) && pct >= threshold) {\n    alerts.push(`• ${mount}: ${pct}% (${used}/${size})`);\n  }\n}\nif (alerts.length === 0) return [];\nconst text = `⚠️ Disk uyarısı (≥${threshold}%)\\n\\n${alerts.join('\\n')}\\n\\n🔗 http://gateway.__LAN_DOMAIN__`;\nreturn [{ json: { text } }];"
      },
      "id": "b1b2c3d4-2222-4000-8000-000000000003",
      "name": "Esik kontrol",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.PI_TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $env.PI_TELEGRAM_CHAT_ID }}" },
            { "name": "text", "value": "={{ $json.text }}" },
            { "name": "disable_web_page_preview", "value": "true" }
          ]
        },
        "options": {}
      },
      "id": "b1b2c3d4-2222-4000-8000-000000000004",
      "name": "Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 300]
    }
  ],
  "connections": {
    "Her 6 saatte": {
      "main": [[{ "node": "Disk durumu", "type": "main", "index": 0 }]]
    },
    "Disk durumu": {
      "main": [[{ "node": "Esik kontrol", "type": "main", "index": 0 }]]
    },
    "Esik kontrol": {
      "main": [[{ "node": "Telegram", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "timezone": "Europe/Istanbul",
    "executionOrder": "v1"
  },
  "meta": { "templateCredsSetupCompleted": true },
  "tags": []
}
