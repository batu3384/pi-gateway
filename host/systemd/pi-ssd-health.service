[Unit]
Description=Pi Gateway SSD liveness / soft-reset
After=local-fs.target

[Service]
Type=oneshot
Nice=10
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
ExecStartPre=/bin/sh -c 'mkdir -p /run/pi-gateway && chown PI_USER:PI_USER /run/pi-gateway && chmod 0775 /run/pi-gateway'
ExecStart=/usr/local/lib/pi-gateway/scripts/pi/ssd-health.sh
TimeoutStartSec=600
KillMode=mixed
