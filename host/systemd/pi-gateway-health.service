[Unit]
Description=Pi Gateway DNS health check
After=docker.service
Requires=docker.service
OnFailure=pi-gateway-health-failure.service

[Service]
Type=oneshot
User=PI_USER
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
ExecStart=/home/PI_USER/pi-gateway/scripts/pi/health-check.sh
Nice=10

[Install]
WantedBy=multi-user.target
