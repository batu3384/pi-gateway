[Unit]
Description=Import AdGuard client names into NetAlertX
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=PI_USER
WorkingDirectory=/home/PI_USER/pi-gateway
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
ExecStart=/bin/bash -lc '/home/PI_USER/pi-gateway/scripts/pi/import-adguard-names-to-netalertx.sh && /home/PI_USER/pi-gateway/scripts/pi/enrich-netalertx-names.sh'
Nice=10
