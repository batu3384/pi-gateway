[Unit]
Description=Pi Gateway earthquake poll (AFAD+Kandilli → Telegram outbox; no Hermes)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=PI_USER
Group=PI_USER
WorkingDirectory=/home/PI_USER/pi-gateway
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
Environment=HOME=/home/PI_USER
ExecStart=/home/PI_USER/pi-gateway/scripts/pi/quake-alert.sh
# Poll 10s; HTTP 5s×2 paralel + notify — asılı kalırsa birikmesin
TimeoutStartSec=25
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
