  tls /etc/caddy/certs/__LAN_DOMAIN__.pem /etc/caddy/certs/__LAN_DOMAIN__-key.pem
  # Host-network NetAlertX — Caddy bridge -> host.docker.internal (extra_hosts)
  reverse_proxy host.docker.internal:__NETALERTX_PORT__ {
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
  }
}
