{
  "id": "f3333333-3333-4333-8333-333333333301",
  "versionId": "f3333333-3333-4333-8333-333333333302",
  "name": "Pi Gateway — Forgejo Push",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "forgejo-push",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "c1b2c3d4-3333-4000-8000-000000000001",
      "name": "Forgejo Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "pi-gateway-forgejo-push"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body ?? raw;\nconst repo = body.repository?.full_name || body.repo?.name || 'repo';\nconst ref = (body.ref || '').replace('refs/heads/', '');\nconst pusher = body.pusher?.login || body.pusher?.name || body.sender?.login || '?';\nconst commits = Array.isArray(body.commits) ? body.commits.slice(0, 5) : [];\nconst lines = commits.map((c) => {\n  const msg = (c.message || '').split('\\n')[0];\n  const who = c.author?.name || c.committer?.name || pusher;\n  return `• ${msg} (${who})`;\n});\nconst text = `📦 Git push\\n\\n📁 ${repo}\\n🌿 ${ref || 'branch?'}\\n👤 ${pusher}\\n\\n${lines.join('\\n') || '(commit detayi yok)'}\\n\\n🔗 http://git.__LAN_DOMAIN__`;\nreturn [{ json: { text } }];"
      },
      "id": "c1b2c3d4-3333-4000-8000-000000000002",
      "name": "Mesaj hazirla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.PI_TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $env.PI_TELEGRAM_CHAT_ID }}" },
            { "name": "text", "value": "={{ $json.text }}" },
            { "name": "disable_web_page_preview", "value": "true" }
          ]
        },
        "options": {}
      },
      "id": "c1b2c3d4-3333-4000-8000-000000000003",
      "name": "Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 300]
    }
  ],
  "connections": {
    "Forgejo Webhook": {
      "main": [[{ "node": "Mesaj hazirla", "type": "main", "index": 0 }]]
    },
    "Mesaj hazirla": {
      "main": [[{ "node": "Telegram", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
