[Unit]
Description=Pi Gateway Telegram panel bot (menu + links)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=PI_USER
WorkingDirectory=/home/PI_USER/pi-gateway
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
ExecStart=/home/PI_USER/pi-gateway/scripts/pi/telegram-bot.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
