// Tailscale ACL — https://login.tailscale.com/admin/acls
// Kopyala-yapistir: Admin Console > Access Controls > Edit
//
// Sahip e-postasini .env -> TAILSCALE_ACL_OWNER ile degistir (make tailscale-acl).

{
  "groups": {
    "group:owners": ["YOUR_TAILSCALE_EMAIL@example.com"]
  },

  "tagOwners": {
    "tag:pi-gateway": ["group:owners"],
    "tag:owner-device": ["group:owners"]
  },

  "acls": [
    {
      "action": "accept",
      "src": ["group:owners", "tag:owner-device"],
      "dst": ["tag:pi-gateway:22", "tag:pi-gateway:80", "tag:pi-gateway:443", "tag:pi-gateway:53"]
    },
    // TS_PANEL_DIRECT_PORTS=true ise Telegram :PORT butonlari — ornek portlar:
    // "dst": ["tag:pi-gateway:3001", "tag:pi-gateway:8080", "tag:pi-gateway:9999", "tag:pi-gateway:5678", "tag:pi-gateway:20211"]
    {
      "action": "accept",
      "src": ["group:owners", "tag:owner-device"],
      "dst": ["YOUR_TAILSCALE_LAN_SUBNET:53,80,443"]
    }
  ],

  "autoApprovers": {
    "routes": {
      "YOUR_TAILSCALE_LAN_SUBNET": ["group:owners"]
    }
  },

  "ssh": [
    {
      "action": "accept",
      "src": ["group:owners", "tag:owner-device"],
      "dst": ["tag:pi-gateway"],
      "users": ["autogroup:nonroot"]
    }
  ]
}
