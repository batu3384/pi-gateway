# =============================================================================
# Pi Gateway - Production Environment
# Copy: cp .env.example .env
# Referans: docs/ENV.md
# =============================================================================

TZ=Europe/Istanbul

# --- Pi SSH ---
PI_USER=pi
PI_HOSTNAME=pi-gateway
PI_HOST=
PI_STATIC_IP=
PI_INTERFACE=eth0
REMOTE_DIR=/home/pi/pi-gateway

# --- Network mode ---
# router-dns   : Router DHCP + DNS -> Pi (router'da bir kez DNS ayari)
# adguard-dhcp : AdGuard DHCP sunar (router DHCP kapatilir, tam otomatik DNS)
NETWORK_MODE=router-dns

LAN_DOMAIN=home
LAN_GATEWAY=
LAN_SUBNET_CIDR=
ROUTER_DNS_SECONDARY=1.1.1.1
# LAN HTTPS (varsayilan). Once: make tls-certs
# HTTP lazimsa: ENABLE_TLS=false + WEAK_TLS_OK=yes (validate/doctor fail-closed)
ENABLE_TLS=true
# WEAK_TLS_OK=yes
SD_HEALTH_AUTO_RECOVER=true
# SSD/Docker/AdGuard duserse watchdog + health otomatik kurtarir
STACK_AUTO_RECOVER=true
# Deploy sonrasi GUI sifrelerini zorla esitlemek icin true yapin
SYNC_SERVICE_PASSWORDS=false
# Offsite yedek (make backup-pull) max yas (gun). 0 = kontrol kapali.
OFFSITE_BACKUP_MAX_AGE_DAYS=7
# WEAK_BACKUP_OK=yes  # Mac doctor'da eski/eksik offsite icin escape

# --- AdGuard admin (otomatik config icin) ---
AGH_ADMIN_USER=admin
# ZORUNLU: degistir. Deploy CHANGE_ME / Degistir* ile basarisiz olur.
AGH_ADMIN_PASSWORD=CHANGE_ME_adguard_password

# Caddy basic_auth (dns/git/sync/n8n/logs). Bos ise AGH_ADMIN_* kullanilir.
# CADDY_AUTH_USER=
# CADDY_AUTH_PASSWORD=

# --- Tailscale (https://login.tailscale.com/admin/settings/keys) ---
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=pi-gateway
# ACL sahibi (Tailscale login e-postasi) — make tailscale-acl
TAILSCALE_ACL_OWNER=

# --- Bildirimler (Telegram: @BotFather + chat id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_COOLDOWN_SEC=300

# --- Servisler ---
ENABLE_CADDY=true
# false onerilir: stack-watchdog + health-check kurtarma yapar; sock = root API
ENABLE_AUTOHEAL=false
ENABLE_DOZZLE=true
ENABLE_WATCHTOWER=false
ENABLE_UFW=true
ENABLE_FAIL2BAN=true
# full | caddy-only (admin portlari yalnizca Caddy/Tailscale)
UFW_ADMIN_EXPOSURE=caddy-only
ADGUARD_WEB_PORT=8080
ADGUARD_BLOCKED_TTL=60
ADGUARD_UPSTREAM_TIMEOUT=5
ADGUARD_BOOT_WAIT_SEC=180
ADGUARD_MIN_FILTER_RULES=100000
ADGUARD_MIN_REWRITES=8
DOZZLE_PORT=9999
DOZZLE_ADMIN_USER=admin
# ZORUNLU: bos birakma — Dozzle fail-closed
DOZZLE_ADMIN_PASSWORD=CHANGE_ME_dozzle_password

# Watchtower (ENABLE_WATCHTOWER=true ise; Telegram ile ayni token):
# WATCHTOWER_NOTIFICATION_URL=telegram://BOT_TOKEN@telegram?chats=CHAT_ID

# --- Uptime Kuma ---
UPTIME_KUMA_ADMIN_USER=admin
# ZORUNLU: bos birakma — post-deploy fail-closed
UPTIME_KUMA_ADMIN_PASSWORD=CHANGE_ME_uptime_kuma_password
UPTIME_KUMA_STATUS_SLUG=pi-gateway

# --- Faz 2: Git, sync, yedek ---
ENABLE_FORGEJO=true
ENABLE_SYNCTHING=true
ENABLE_RESTIC=true
FORGEJO_PORT=3002
FORGEJO_DOMAIN=git.home
SYNCTHING_PORT=8384
SYNCTHING_MAC_DEVICE_ID=
SYNCTHING_GUI_USER=admin
# ZORUNLU: bos birakma — Syncthing GUI
SYNCTHING_GUI_PASSWORD=CHANGE_ME_syncthing_password
RESTIC_REPOSITORY=/mnt/ssd/pi-gateway-data/backups/restic
RESTIC_PASSWORD=CHANGE_ME_restic_password
# Bozuk repo otomatik reinit etmez; bilincli operator kurtarmasi icin true yap.
RESTIC_ALLOW_REINIT=false
# restic backup/check timeout (saniye). JMicron I/O'da asilmayi onler.
RESTIC_TIMEOUT_SEC=7200
RESTIC_CHOWN_TIMEOUT_SEC=120
RESTIC_CHECK_SUBSET=5%
# Opsiyonel: restic snapshot host etiketi (varsayilan PI_HOSTNAME)
# RESTIC_BACKUP_HOST=pi-gateway
# Mac offsite (3-2-1): make backup-pull — SSD restic tek basina yedek DEGIL
# MAC_BACKUP_DEST varsayilan ~/Backups/pi-gateway
# Haftalik otomatik: make backup-cron (onerilir)
BACKUP_CRON_WEEKDAY=0
BACKUP_CRON_HOUR=3

FORGEJO_ADMIN_USER=admin
FORGEJO_ADMIN_PASSWORD=CHANGE_ME_forgejo_password
FORGEJO_ADMIN_EMAIL=admin@home.local
FORGEJO_REPO_NAME=pi-gateway

# n8n webhook path secret (URL sonuna eklenir) — ZORUNLU degistir
N8N_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
# n8n webhook (Docker agi icinden)
N8N_KUMA_WEBHOOK_URL=http://n8n:5678/webhook/uptime-kuma-alert
N8N_FORGEJO_WEBHOOK_URL=http://n8n:5678/webhook/forgejo-push

# --- Faz 3 ---
# Redis: tuketici yok — varsayilan kapali (ENABLE_REDIS=true ile acilir)
ENABLE_REDIS=false
# ZORUNLU (ENABLE_REDIS=true iken): degistir
REDIS_PASSWORD=CHANGE_ME_redis_password
ENABLE_N8N=true
ENABLE_NETALERTX=true
NETALERTX_PORT=20211
# Host network; UI sadece loopback (Caddy devices.home). LAN acmak icin 0.0.0.0 + UFW bilerek.
NETALERTX_LISTEN_ADDR=172.17.0.1
# NetAlertX UI sifresi (bos ise AGH_ADMIN_PASSWORD). Caddy basic_auth kullanilmaz (API popup dongusu).
# NETALERTX_PASSWORD=
# Bos ise LAN_SUBNET_CIDR + PI_INTERFACE ile otomatik (ornek: 192.168.1.0/24 --interface=eth0)
NETALERTX_SCAN_SUBNETS=
ENABLE_CROWDSEC=true
# CrowdSec threat intel: false = online API (opt-in). Default offline.
CROWDSEC_DISABLE_ONLINE_API=true
CROWDSEC_BOUNCER_KEY=
N8N_PORT=5678
# ENABLE_TLS=true iken true olmali (render/validate uyarir)
N8N_SECURE_COOKIE=true
# ZORUNLU (n8n acikken): openssl rand -hex 24 — Pi'de bos ise post-deploy otomatik uretir
N8N_ENCRYPTION_KEY=
CLOUDFLARE_TUNNEL_TOKEN=

DISK_WARN_PCT=80

# --- Depolama ---
# hybrid    : OS SD'de, data+docker SSD (/mnt/ssd) — varsayilan, en guvenilir boot
# ssd-data  : hybrid alias
# ssd-root  : SD=bootfs only, SSD=rootfs (JMicron/EEPROM riski)
STORAGE_TYPE=hybrid
# Yalnizca hybrid/ssd-data: SSD yokken SD uzerinde core DNS
# STORAGE_FALLBACK_SD=true ayni DNS degraded yolunu acar (geriye uyum)
STORAGE_FALLBACK_SD=false
# SSD kopunca Unbound+AdGuard SD'de ayakta kalsin (varsayilan true)
DNS_DEGRADED_ON_SSD_LOSS=true
# Soft-reset / probe (JMicron)
# SSD_PROBE_TIMEOUT_SEC=3
# SSD_USB_RESET_MAX=3
# SSD_USB_RESET_WINDOW_SEC=900
# SSD_HOTPLUG_DEBOUNCE_SEC=30
# SSD_USB_RESET_REBOOT=false
# SSD_USB_AUTHORIZED_RESET=false  # true: authorized 0→1 (JMS583 bazen kaybolur)
# SSD_USB_PORT_DISABLE_CYCLE=true   # usb2-port disable (tak-cikar yerine)
# SSD_USB_XHCI_REBIND=false         # true: PCI xhci unbind/rebind (tum USB3 collateral)
# hybrid: Docker data-root SSD'ye (JMicron USB I/O riski — varsayilan kapali)
ENABLE_DOCKER_SSD=false
DOCKER_SSD_ROOT=/mnt/ssd/docker
