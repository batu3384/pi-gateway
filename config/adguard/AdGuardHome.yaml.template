http:
  pprof:
    port: 6060
    enabled: false
  address: 0.0.0.0:${ADGUARD_WEB_PORT}
  session_ttl: 720h

users:
  - name: ${AGH_ADMIN_USER}
    password: __PASSWORD_HASH__

dns:
  bind_hosts:
    - 0.0.0.0
    - "::"
  port: 53
  upstream_dns:
    - udp://127.0.0.1:5335
    - tcp://127.0.0.1:5335
  bootstrap_dns:
    - 127.0.0.1:5335
  protection_enabled: true
  filtering_enabled: true
  ratelimit: 20
  refuse_any: true
  upstream_mode: load_balance
  upstream_timeout: 5s
  blocked_response_ttl: 60
  cache_size: 4194304
  cache_ttl_min: 300
  cache_ttl_max: 86400
  cache_optimistic: true
  local_domain_name: ${LAN_DOMAIN}
  use_private_ptr_resolvers: false
  local_ptr_upstreams: []
  default_local_ptr_upstreams: []
  rewrites:
    - domain: gateway.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: dns.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: status.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: panel.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: git.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: sync.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: n8n.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: logs.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: devices.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: grafana.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}

# DNS-only stack (telefon AdGuard HTTPS/CSS degil). OISD Pro++ icinde — tekrar yok.
filters:
__FILTER_LISTS_YAML__

user_rules:
__USER_RULES_YAML__

querylog:
  enabled: true
  interval: 24h
  size_memory: 1000

statistics:
  enabled: true
  interval: 24h

__DHCP_BLOCK__

schema_version: 29
