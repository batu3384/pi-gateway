// Pi Gateway — yalnizca sahip hesabin cihazlari (batu3384@gmail.com)
// Uygula: make tailscale-acl  veya admin panelden yapistir

{
  "groups": {
    "group:owners": ["batu3384@gmail.com"]
  },

  "acls": [
    {
      "action": "accept",
      "src": ["group:owners"],
      "dst": ["*:*"]
    },
    {
      "action": "accept",
      "src": ["group:owners"],
      "dst": ["192.168.1.0/24:*"]
    }
  ],

  "autoApprovers": {
    "routes": {
      "192.168.1.0/24": ["group:owners"]
    }
  },

  "ssh": [
    {
      "action": "accept",
      "src": ["group:owners"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"]
    }
  ]
}
