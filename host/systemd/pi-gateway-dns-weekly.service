[Unit]
Description=Pi Gateway weekly DNS coverage Telegram report

[Service]
Type=oneshot
User=PI_USER
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
ExecStart=/home/PI_USER/pi-gateway/scripts/pi/dns-coverage-weekly.sh
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
