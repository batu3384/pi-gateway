(security_headers) {
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy no-referrer
  }
}

gateway.__LAN_DOMAIN__, panel.__LAN_DOMAIN__ {
  tls /etc/caddy/certs/__LAN_DOMAIN__.pem /etc/caddy/certs/__LAN_DOMAIN__-key.pem
  import security_headers
  __CADDY_BASIC_AUTH__
  reverse_proxy glance:8080
}

status.__LAN_DOMAIN__ {
  tls /etc/caddy/certs/__LAN_DOMAIN__.pem /etc/caddy/certs/__LAN_DOMAIN__-key.pem
  import security_headers
  __CADDY_BASIC_AUTH__
  reverse_proxy gatus:8080
}

dns.__LAN_DOMAIN__ {
  tls /etc/caddy/certs/__LAN_DOMAIN__.pem /etc/caddy/certs/__LAN_DOMAIN__-key.pem
  import security_headers
  __CADDY_BASIC_AUTH__
  reverse_proxy host.docker.internal:__ADGUARD_WEB_PORT__
}

logs.__LAN_DOMAIN__ {
  tls /etc/caddy/certs/__LAN_DOMAIN__.pem /etc/caddy/certs/__LAN_DOMAIN__-key.pem
  import security_headers
  __CADDY_BASIC_AUTH__
  reverse_proxy dozzle:8080
}

grafana.__LAN_DOMAIN__ {
  tls /etc/caddy/certs/__LAN_DOMAIN__.pem /etc/caddy/certs/__LAN_DOMAIN__-key.pem
  import security_headers
  __CADDY_BASIC_AUTH__
  reverse_proxy grafana:3000
}

devices.__LAN_DOMAIN__ {
  tls /etc/caddy/certs/__LAN_DOMAIN__.pem /etc/caddy/certs/__LAN_DOMAIN__-key.pem
  import security_headers
  # Caddy basic_auth yok — NetAlertX kendi UI sifresi (Caddy auth = API popup dongusu, smoke sözleşmesi)
  # Host-network NetAlertX — Caddy bridge -> host.docker.internal (extra_hosts)
  reverse_proxy host.docker.internal:__NETALERTX_PORT__ {
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
  }
}
