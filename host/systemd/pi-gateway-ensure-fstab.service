[Unit]
Description=Pi Gateway ensure SSD fstab entry
DefaultDependencies=no
After=systemd-udevd.service local-fs.target pi-ssd-data.service
Before=remote-fs.target mnt-ssd.mount pi-gateway-recover-ro.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=60
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
ExecStart=/usr/local/lib/pi-gateway/scripts/pi/ensure-ssd-fstab.sh

[Install]
WantedBy=multi-user.target
