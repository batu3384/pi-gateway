gateway.__LAN_DOMAIN__, panel.__LAN_DOMAIN__ {
  tls /etc/caddy/certs/__LAN_DOMAIN__.pem /etc/caddy/certs/__LAN_DOMAIN__-key.pem
  __CADDY_BASIC_AUTH__
  reverse_proxy homepage:3000
}

