[Unit]
Description=Pi fleet watchdog (no LLM unless threshold)
After=docker.service network-online.target

[Service]
Type=oneshot
User=PI_USER
Group=PI_USER
Environment=REMOTE_DIR=/home/PI_USER/pi-gateway
ExecStart=/usr/local/lib/pi-gateway/scripts/pi/pi-fleet-watchdog.sh
TimeoutStartSec=90
Nice=10
