http:
  pprof:
    port: 6060
    enabled: false
  address: 0.0.0.0:${ADGUARD_WEB_PORT}
  session_ttl: 720h

users:
  - name: ${AGH_ADMIN_USER}
    password: __PASSWORD_HASH__

dns:
  bind_hosts:
    - 0.0.0.0
    - "::"
  port: 53
  upstream_dns:
    - udp://127.0.0.1:5335
  # Modem WAN :53 drop oldugu icin Unbound duserse DoT (:853) bootstrap kullanilir.
  bootstrap_dns:
    - 127.0.0.1:5335
    - 1.1.1.2
    - 1.0.0.2
    - 9.9.9.9
  fallback_dns:
    - tls://1.1.1.2
    - tls://1.0.0.2
    - h3://security.cloudflare-dns.com/dns-query
    - tls://9.9.9.9
    - tls://dns.adguard-dns.com
  protection_enabled: true
  filtering_enabled: true
  # 0 = kapali (UFW :53 LAN/Tailscale sinirli). apply-adguard-dns ADGUARD_RATELIMIT ile override.
  ratelimit: 0
  ratelimit_subnet_len_ipv4: 32
  ratelimit_subnet_len_ipv6: 128
  refuse_any: true
  upstream_mode: load_balance
  use_http3_upstreams: true
  upstream_timeout: 2s
  blocking_mode: default
  blocked_response_ttl: 300
  cache_size: 33554432
  cache_ttl_min: 60
  cache_ttl_max: 86400
  cache_optimistic: true
  # YAML tag; JSON API alanı disable_ipv6 (apply-adguard-dns).
  aaaa_disabled: true
  local_domain_name: ${LAN_DOMAIN}
  use_private_ptr_resolvers: false
  local_ptr_upstreams: []
  default_local_ptr_upstreams: []
  rewrites:
    - domain: gateway.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: dns.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: status.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: panel.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: logs.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: devices.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}
    - domain: grafana.${LAN_DOMAIN}
      answer: ${PI_STATIC_IP}

# DNS-only stack (telefon AdGuard HTTPS/CSS degil). OISD Pro++ icinde — tekrar yok.
filters:
__FILTER_LISTS_YAML__

user_rules:
__USER_RULES_YAML__

querylog:
  enabled: true
  interval: 168h
  size_memory: 2000

statistics:
  enabled: true
  interval: 168h

__DHCP_BLOCK__

schema_version: 29
